{
    "name": "cacti-gui-maker",
    "version": "1.0.0",
    "author": "CactiFX <fxcacti@gmail.com>",
    "main": "dist/index.js",
    "description": "Cacti GUI Maker",
    "keywords": [],
    "license": "ISC",
    "scripts": {
        "start": "electron .",
        "build": "tsc",
        "package": "electron-builder -w"
    },
    "build": {
        "appId": "com.cacti.guiMaker",
        "copyright": "Copyright (c) 2025 CactiFX",
        "productName": "Cacti GUI Maker",
        "directories": {
            "output": "releases/${platform}/${arch}"
        },
        "files": [
            "build/",
            "dist/**/*",
            "wwwroot/**/*"
        ],
        "extraResources": [
            {
                "from": "wwwroot",
                "to": "wwwroot",
                "filter": [
                    "**/*"
                ]
            }
        ]
    },
    "type": "module",
    "dependencies": {
        "@napi-rs/canvas": "^0.1.54",
        "express": "^4.19.2",
        "sharp": "^0.33.5",
        "unzipper": "^0.12.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^22.5.1",
        "@types/unzipper": "^0.10.10",
        "electron": "^32.0.1",
        "electron-builder": "^25.0.5",
        "tsx": "^4.19.0",
        "typescript": "^5.5.4"
    }
}
